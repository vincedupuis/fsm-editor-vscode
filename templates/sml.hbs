{{!-- ================================================================ Order.cpp: the constants and events --}}

{{#*inline "constants"}}
inline constexpr int STATE_COUNT = {{states.length}};
inline constexpr int REGION_COUNT = {{regions.length}};
inline constexpr int EVENT_COUNT = {{events.length}};
inline constexpr int TIMER_COUNT = {{timers.length}};
/// Region containing each state.
inline constexpr std::array<int, STATE_COUNT> REGION_OF = { {{~join states ", " "regionIndex"~}} };
/// State owning each region (-1 for the top-level ones).
inline constexpr std::array<int, REGION_COUNT> OWNER_OF = { {{~join regions ", " "ownerIndex"~}} };
inline constexpr std::array<bool, STATE_COUNT> IS_FINAL = { {{~join states ", " "isFinal"~}} };
/// When each state completes: 0 when entered, 1 when its do activities end, 2 when its regions are final, 3 when its
/// submachine finishes, 4 never (final states).
inline constexpr std::array<int, STATE_COUNT> COMPLETES = { {{~#each states}}{{#unless @first}}, {{/unless}}{{lookup @root.options.completes completes}}{{/each~}} };
inline constexpr std::array<int, STATE_COUNT> ACTIVITY_COUNT = { {{~#each states}}{{#unless @first}}, {{/unless}}{{activities.length}}{{/each~}} };
/// Table event of each state's completion (-1: no transition waits for it).
inline constexpr std::array<int, STATE_COUNT> COMPLETION_EVENT = { {{~#each tables.completionEvents}}{{#unless @first}}, {{/unless}}{{#if this}}{{index}}{{else}}-1{{/if}}{{/each~}} };
inline constexpr std::array<const char*, STATE_COUNT> STATE_NAMES = { {{~#each states}}{{#unless @first}}, {{/unless}}{{quote name}}{{/each~}} };
inline constexpr int START = {{#each tables.events}}{{#if (eq kind "start")}}{{index}}{{/if}}{{/each}};
inline constexpr int STOP = {{#each tables.events}}{{#if (eq kind "stop")}}{{index}}{{/if}}{{/each}};
/// Region entry routes: 0 by default, 1 deep resume (resumeMachine(), deep history); the others are in the tables.
inline constexpr int DEEP = 1;
inline constexpr int NONE = 0;
inline constexpr int DEFERRED = 1;
inline constexpr int FIRED = 2;

/// The machine's events.
namespace events {
{{#each events}}
struct {{id name}} {};
{{/each}}
}  // namespace events

/// Events of the tables themselves: start and stop, timers, completion events, continuations, submachine exit points.
namespace internal {
{{#each tables.events}}
struct {{id name}} {};
{{/each}}
}  // namespace internal

/// States: simple and final states are tags, composite states are the structs of their tables (below).
namespace states {
{{#each states}}
{{#unless regions.length}}
struct {{id name}};
{{/unless}}
{{/each}}
}  // namespace states

/// Pseudostates of the tables: where regions start, choices, and where a table waits to be left.
namespace pseudo {
{{#each tables.list}}
{{#each pseudostates}}
struct {{id name}};
{{/each}}
{{/each}}
}  // namespace pseudo
{{/inline}}

