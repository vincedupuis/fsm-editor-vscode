{{!-- ================================================================ OrderActions.h --}}

{{#*inline "actionsHeader"}}
{{> generated}}
#pragma once
{{#if submachines.length}}

{{#each submachines}}
#include "{{name}}Actions.h"
{{/each}}
{{/if}}
{{#if features.constraints}}

/// Constraints reported to onConstraintViolation().
enum class {{machine.name}}Constraint { invariant, precondition, postcondition };
{{/if}}

/// What {{machine.displayName}} needs: implement it to give the machine its behavior, and pass it to {{machine.name}}'s constructor.
{{#if machine.documentation}}
///
/// {{machine.documentation}}
{{/if}}
class {{machine.name}}Actions {
public:
    virtual ~{{machine.name}}Actions() = default;
{{#if actions.length}}

    // Behaviors: entry, exit and transition effects.
{{#each actions}}
    virtual void {{id this}}() = 0;
{{/each}}
{{/if}}
{{#if conditions.length}}

    // Conditions: guards{{#if machine.protocol}}, invariants, pre- and postconditions{{else}}{{#if features.invariants}} and invariants{{/if}}{{/if}}.
{{#each conditions}}
    virtual bool {{id this}}() = 0;
{{/each}}
{{/if}}
{{#if activities.length}}

    // Do activities.
{{#each activities}}
    /// Starts the do activity {{this}}(). Call activityDone({{@root.machine.name}}Activity::{{id this}}) if it ends by itself.
    virtual void start{{pascal this}}() = 0;
    /// Aborts the do activity {{this}}(): its state is being left.
    virtual void stop{{pascal this}}() = 0;
{{/each}}
{{/if}}
{{#if features.constraints}}

    /// A state invariant, precondition or postcondition does not hold. `element` names the state or transition.
    virtual void onConstraintViolation({{machine.name}}Constraint kind, const char* element) = 0;
{{/if}}
{{#if features.terminate}}

    /// The machine reached a terminate pseudostate and stopped.
    virtual void onTerminate() = 0;
{{/if}}
{{#if features.submachines}}

    // Behavior of the submachine states.
{{#each states}}
{{#if submachine}}
    virtual {{submachine.machine}}Actions& submachine{{pascal name}}() = 0;
{{/if}}
{{/each}}
{{/if}}
};
{{/inline}}

{{!-- ================================================================ FsmTimers.h (the same for every machine) --}}

{{#*inline "timersHeader"}}
// Generated by FSM Editor.
// Do not edit: changes are lost when the code is regenerated.
#pragma once

#include <chrono>
#include <cstdint>
#include <functional>

/// Starts and cancels the timers of the time events (after(...)) of the state machines FSM Editor generates.
/// Implement it once and pass it to every machine that has time events, itself or in its submachines.
class FsmTimers {
public:
    using Id = std::uint64_t;

    virtual ~FsmTimers() = default;

    /// Calls fire() once, after delay, unless the timer is cancelled first. Call it on the thread that sends the
    /// machines their events, and never from within startTimer() or cancelTimer().
    virtual Id startTimer(std::chrono::milliseconds delay, std::function<void()> fire) = 0;
    /// Cancels a timer that startTimer() returned. A timer that has fired or was cancelled is ignored.
    virtual void cancelTimer(Id timer) = 0;
};
{{/inline}}

