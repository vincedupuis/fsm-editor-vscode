---
# C++17 with Boost.SML (https://github.com/boost-ext/sml). For a machine named Order it writes:
#   OrderEvents.h    what the machine reacts to: the OrderEvents interface, one method per event
#   OrderActions.h   what the machine needs: the OrderActions interface to implement (behaviors,
#                    conditions, do activities)
#   FsmTimers.h      the timers of time events (after(...)), shared by every machine: implement
#                    FsmTimers once and pass it to the machines that have time events
#   Order.h          the Order class, which implements OrderEvents
#   Order.cpp        its implementation: the Boost.SML transition tables and their runtime.
#                    Only this file includes <boost/sml.hpp>.
# Implement OrderActions in your own class, in a file of your own.
#
# Boost.SML has no transitions across composite states, entry or exit points, forks, joins,
# history that behaves like UML's, or local transitions: the generated code works around them
# and the generator prints a warning for each. What it cannot express is an error, and nothing
# is generated.
#
# The template has three parts: the pieces of C++ (partials), the checks (warnings and
# errors), then the files, each written by a partial.
lang: cpp
guard:
  prefix: "c.actions."
options:
  # Methods of the generated class and of the actions interface, which events and behaviors cannot be named after.
  classMethods: [startMachine, startMachineAt, resumeMachine, stopMachine, setListener, activityDone, isIn, activeStates, isFinished, isTerminated, offer]
  actionsMethods: [onConstraintViolation, onTerminate]
  # Kinds of row triggers that take an event (the others are entry, exit and anonymous).
  triggers: [event, table]
  # When a state completes (code model `completes`), as numbered in COMPLETES.
  completes:
    immediate: 0
    activities: 1
    regions: 2
    submachine: 3
    never: 4
---
{{!-- ================================================================ pieces of C++ --}}

{{!-- The first lines of every file. --}}
{{#*inline "generated"}}
// Generated by FSM Editor from {{machine.sourceFile}}.
// Do not edit: changes are lost when the code is regenerated.
{{/inline}}

{{!-- A state or pseudostate of a table (code model `tables`), as an SML state. --}}
{{#*inline "smlState"}}sml::state<{{#if (eq kind "pseudo")}}pseudo{{else}}states{{/if}}::{{id name}}>{{/inline}}

{{!-- The entry or exit steps of a state, on one line. --}}
{{#*inline "steps"}}
{{~#each steps}}
{{~#switch kind}}
  {{#case "call"}} c.actions.{{id action}}();{{/case}}
  {{#case "startActivity"}} c.actions.start{{pascal activity}}();{{/case}}
  {{#case "stopActivity"}} c.actions.stop{{pascal activity}}();{{/case}}
  {{#case "startTimer"}} c.startTimer({{timerIndex}}, {{ms}});{{/case}}
  {{#case "cancelTimer"}} c.cancelTimer({{timerIndex}});{{/case}}
  {{#case "stopSubmachine"}} c.sub_{{state}}.stopMachine();{{/case}}
{{/switch}}
{{~/each}}
{{~/inline}}

{{!-- An action of a table row: one statement of its lambda. --}}
{{#*inline "action"}}
{{~#switch kind}}
  {{#case "stateEntry"}} c.enter({{state.index}});{{> steps steps=state.entry}}{{#if state.submachine}} c.startSubmachine({{state.index}});{{/if}} c.entered({{state.index}});{{/case}}
  {{#case "stateExit"}}{{> steps steps=state.exit}} c.exited({{state.index}});{{/case}}
  {{#case "call"}} c.actions.{{id action}}();{{/case}}
  {{#case "postcondition"}} c.postcondition({{index}});{{/case}}
  {{#case "terminate"}} c.terminate();{{/case}}
  {{#case "exitMachine"}} c.exitMachine({{@root.machine.name}}ExitPoint::{{id point}});{{/case}}
  {{#case "continue"}} c.next({{event.index}});{{/case}}
  {{#case "route"}} c.route({{region}}, {{route}}, {{history}});{{/case}}
  {{#case "submachineAt"}} c.startAt({{state.index}}, {{pointIndex}});{{/case}}
  {{#case "entering"}} c.entering({{region}});{{/case}}
  {{#case "restore"}} c.restore({{region}}, {{state.index}});{{/case}}
  {{#case "defer"}} c.defer();{{/case}}
  {{#case "noBranch"}} c.noBranch({{quote label}});{{/case}}
{{/switch}}
{{~/inline}}

{{!-- A guard term of a table row: one operand of its guard's &&. --}}
{{#*inline "term"}}
{{~#switch kind}}
  {{#case "condition"}}({{guard condition}}){{/case}}
  {{#case "precondition"}}c.pre({{guard condition}}, {{quote label}}){{/case}}
  {{#case "requires"}}c.allCompleted({ {{join states ", " "index"}} }){{/case}}
  {{#case "offer"}}c.sub_{{state.name}}.offer({{submachine}}Event::{{id event}}){{/case}}
  {{#case "routed"}}c.routed({{region}}, {{route}}){{/case}}
  {{#case "restores"}}c.restores({{region}}, {{route}}, {{state.index}}){{/case}}
  {{#case "defaults"}}c.defaults({{region}}){{/case}}
{{/switch}}
{{~/inline}}

{{!-- The trigger of a table row, none for an anonymous one. --}}
{{#*inline "trigger"}}
{{~#if trigger}}
{{~#switch trigger.kind}}
  {{#case "event"}} + sml::event<events::{{id trigger.name}}>{{/case}}
  {{#case "table"}} + sml::event<internal::{{id trigger.name}}>{{/case}}
  {{#case "entry"}} + sml::on_entry<sml::_>{{/case}}
  {{#case "exit"}} + sml::on_exit<sml::_>{{/case}}
{{/switch}}
{{~/if}}
{{~/inline}}

{{!-- With deferred events, a row taking an event marks it fired, so that the event isn't deferred too. --}}
{{#*inline "fired"}}
{{~#if (and @root.features.deferral (includes @root.options.triggers trigger.kind))}}
{{~#unless (eq actions.[0].kind "defer")}} c.fired = true;{{/unless}}
{{~/if}}
{{~/inline}}

{{!-- The lambda of a table row: its actions (none when nothing is to be done). --}}
{{#*inline "lambda"}}
{{~#if (or actions.length (and @root.features.deferral (includes @root.options.triggers trigger.kind)))}} / [](Context& c) { {{~> fired}}{{#each actions}}{{> action}}{{/each}} }{{/if}}
{{~/inline}}

{{!-- A table row: source, trigger, guard, actions, target. --}}
{{#*inline "row"}}
{{~#if initial}}(*{{> smlState source}}){{else}}{{> smlState source}}{{/if}}
{{~> trigger}}
{{~#if guard.length}} [([](Context& c) { return {{#each guard}}{{#unless @first}} && {{/unless}}{{> term}}{{/each}}; })]{{/if}}
{{~> lambda}}
{{~#if target}} = {{> smlState target}}{{/if}}
{{~/inline}}

{{!-- The body of a table's struct. --}}
{{#*inline "table"}}
    auto operator()() const {
        return sml::make_transition_table(
{{#each rows}}
            {{> row}}{{#unless @last}},{{/unless}}{{#if comment}}  // {{comment}}{{/if}}
{{/each}}
        );
    }
{{/inline}}

{{!-- ================================================================ checks --}}

{{#*inline "checks"}}
{{#each events}}
{{#if (or (includes @root.options.classMethods name) (eq name @root.machine.name))}}
{{error "Event '" name "': its method " name "() clashes with a method of the generated class " @root.machine.name "; rename the event"}}
{{/if}}
{{/each}}
{{#each actions}}
{{#if (includes @root.conditions this)}}
{{error "'" this "' is called both as a behavior and as a condition: in C++ it would be two methods " this "() returning void and bool; rename one of them"}}
{{/if}}
{{#if (includes @root.options.actionsMethods this)}}
{{error "Behavior '" this "': its method " this "() clashes with a method of " @root.machine.name "Actions; rename it"}}
{{/if}}
{{/each}}
{{#each tables.notes}}
{{#switch kind}}
{{#case "leave"}}{{warn "Transition '" element "': Boost.SML has no transitions out of a composite state's inside; " state " takes the event and " detail " is left through an internal event" id=id}}{{/case}}
{{#case "enter"}}{{warn "Transition '" element "': Boost.SML has no transitions into a composite state's inside; it enters " state ", whose initial pseudostate leads on to " detail id=id}}{{/case}}
{{#case "exitPoint"}}{{warn "Exit point '" element "': Boost.SML has no exit points; the state taking the event leaves the composite state through an internal event" id=id}}{{/case}}
{{#case "entryPoint"}}{{warn "Entry point '" element "': Boost.SML has no entry points; transitions to it enter the state, whose initial pseudostates follow the entry point" id=id}}{{/case}}
{{#case "fork"}}{{warn "Fork '" element "': Boost.SML has no forks; transitions to it enter the composite state, whose initial pseudostates lead to the fork's targets" id=id}}{{/case}}
{{#case "join"}}{{warn "Join '" element "': Boost.SML has no joins; the completion of each source checks that the others have completed, then the composite state is left through an internal event" id=id}}{{/case}}
{{#case "history"}}{{warn "History '" element "': Boost.SML's history (sml::H) is shallow and applies to every entry of the state; the generated code records each region's last active state, and the region's initial pseudostate restores it when entered through the " detail " history" id=id}}{{/case}}
{{#case "local"}}{{warn "Transition '" element "': Boost.SML has no local transitions; it is written as a transition of each state of " state "'s region, which leaves the active substate but not " state id=id}}{{/case}}
{{#case "orthogonal"}}{{warn "In " state ", several regions react to '" detail "': Boost.SML fires their transitions one region after the other, so the guards of a later region are evaluated after the transitions of the earlier ones fired" id=id}}{{/case}}
{{/switch}}
{{/each}}
{{#each tables.problems}}
{{#switch kind}}
{{#case "topRegions"}}{{error "Transition '" element "': Boost.SML cannot run a transition between the machine's top-level regions" id=id}}{{/case}}
{{#case "localRegions"}}{{error "Transition '" element "': Boost.SML has no local transitions, and " state " has several regions, which a transition of one region cannot leave together" id=id}}{{/case}}
{{#default}}{{error "Transition '" element "': the Boost.SML tables cannot express it (" detail ")" id=id}}{{/default}}
{{/switch}}
{{/each}}
{{/inline}}

