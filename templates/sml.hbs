{{!-- ================================================================ Order.cpp: Runtime --}}

{{#*inline "runtime"}}
/// Runs the tables: the queues of Context, one event at a time.
struct Runtime final : Context {
    using Context::Context;

    std::optional<sml::sm<Machine>> sm;
    bool running = false;

    /// Sets running while processing, and resets it even when an exception leaves.
    struct Running {
        explicit Running(bool& flag) : flag(flag) { flag = true; }
        ~Running() { flag = false; }
        bool& flag;
    };

    void begin() {
        sm.emplace(static_cast<Context&>(*this));
        active.fill(-1);
        completed.fill(false);
{{#if features.submachines}}
        submode.fill(0);
{{/if}}
        queue.clear();
        deferred.clear();
        work.clear();
        continuations.clear();
        finished = false;
        terminated = false;
    }

    void enterMachine() {
        {
            Running guard(running);
            step(START, true);
        }
        run();
    }

    void run() override {
        if (running || !sm) return;
        Running guard(running);
        while (!terminated) {
            if (!work.empty()) {
                const int e = work.front();
                work.pop_front();
                if (step(e, true)) {
                    changed();
                    checkInvariants();
                }
                continue;
            }
            if (queue.empty()) break;
            const int signal = queue.front();
            queue.pop_front();
            process(signal);
        }
    }

    /// One run-to-completion step for `signal`: Boost.SML selects and fires the transitions.
    int process(int signal) {
{{#if features.preconditions}}
        preconditionFailed = nullptr;
{{/if}}
{{#if features.deferral}}
        fired = false;
        deferredNow = false;
{{/if}}
        const bool handled = step(signal, false);
        if (terminated) return FIRED;
{{#if features.deferral}}
        const int result = !handled ? NONE : fired || !deferredNow ? FIRED : DEFERRED;
{{else}}
        const int result = handled ? FIRED : NONE;
{{/if}}
        if (result == FIRED) changed();
        else if (result == DEFERRED) deferred.push_back(signal);
{{#if features.preconditions}}
        else if (preconditionFailed) actions.onConstraintViolation({{machine.name}}Constraint::precondition, preconditionFailed);
{{/if}}
        checkInvariants();
        return result;
    }

    /// The event, then the continuations of the transitions it fired.
    bool step(int e, bool table) {
        bool handled = false;
        try {
            handled = table ? dispatchTable(e) : dispatchSignal(e);
            while (!continuations.empty()) {
                const int next = continuations.front();
                continuations.pop_front();
                dispatchTable(next);
            }
        } catch (const Terminated&) {
            return true;
        }
        checkPostconditions();
{{#if exitPoints.length}}
        if (exitPoint >= 0) {
            const auto point = static_cast<{{machine.name}}ExitPoint>(exitPoint);
            exitPoint = -1;
            if (listener) listener->onExitPoint(point);
        }
{{/if}}
        return handled;
    }

    /// The configuration changed: deferred events get another chance, first.
    void changed() {
        queue.insert(queue.begin(), deferred.begin(), deferred.end());
        deferred.clear();
    }

    bool dispatchSignal(int signal) {
        switch (signal) {
{{#each events}}
        case {{signalIndex}}:
            return sm->process_event(events::{{id name}}{});
{{/each}}
{{#each timers}}
        case {{signalIndex}}:
            return sm->process_event(internal::{{id (lookup (lookup @root.tables.timerEvents index) "name")}}{});
{{/each}}
        default:
            return false;
        }
    }

    bool dispatchTable(int e) {
        switch (e) {
{{#each tables.events}}
        case {{index}}:
            return sm->process_event(internal::{{id name}}{});
{{/each}}
        default:
            return false;
        }
    }

    bool offer(int signal) {
        if (terminated || running || !sm) return false;
        int result;
        {
            Running guard(running);
            result = process(signal);
        }
        run();
        return result != NONE;
    }
};
{{/inline}}

