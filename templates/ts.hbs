// Generated by FSM Editor from {{machine.sourceFile}}.
// Do not edit: changes are lost when the code is regenerated.
{{#each submachines}}
import type { {{name}}Actions } from './{{name}}Actions';
{{/each}}

/** Events accepted by {{machine.displayName}}{{#if features.submachines}}, including those of its submachines{{/if}}. */
export type {{machine.name}}Event = {{#if events.length}}{{#each events}}{{#unless @first}} | {{/unless}}{{quote name}}{{/each}}{{else}}never{{/if}};

/** States of {{machine.displayName}}. */
export type {{machine.name}}State = {{#if states.length}}{{#each states}}{{#unless @first}} | {{/unless}}{{quote name}}{{/each}}{{else}}never{{/if}};

/** Do activities; report their end with activityDone(). */
export type {{machine.name}}Activity = {{#if activities.length}}{{#each activities}}{{#unless @first}} | {{/unless}}{{quote this}}{{/each}}{{else}}never{{/if}};

/** Entry points, for startAt(). */
export type {{machine.name}}EntryPoint = {{#if entryPoints.length}}{{#each entryPoints}}{{#unless @first}} | {{/unless}}{{quote name}}{{/each}}{{else}}never{{/if}};

/** Exit points, reported to onExitPoint. */
export type {{machine.name}}ExitPoint = {{#if exitPoints.length}}{{#each exitPoints}}{{#unless @first}} | {{/unless}}{{quote name}}{{/each}}{{else}}never{{/if}};

/**
 * What {{machine.displayName}} calls: implement it to give the machine its behavior.
{{#if machine.documentation}}
 *
 * {{machine.documentation}}
{{/if}}
 */
export interface {{machine.name}}Actions {
{{#each actions}}
  {{id this}}(): void;
{{/each}}
{{#each conditions}}
  {{id this}}(): boolean;
{{/each}}
{{#each activities}}
  /** Starts the do activity {{this}}(). Call activityDone({{quote this}}) if it ends by itself. */
  start{{pascal this}}(): void;
  /** Aborts the do activity {{this}}(): its state is being left. */
  stop{{pascal this}}(): void;
{{/each}}
{{#if features.constraints}}
  /** A state invariant, precondition or postcondition does not hold. */
  onConstraintViolation(kind: 'invariant' | 'precondition' | 'postcondition', element: string): void;
{{/if}}
{{#if features.terminate}}
  /** The machine reached a terminate pseudostate and stopped. */
  onTerminate(): void;
{{/if}}
{{#if features.submachines}}
  /** Behavior of the submachine states. */
  readonly submachines: {
{{#each states}}
{{#if submachine}}
    {{name}}: {{submachine.machine}}Actions;
{{/if}}
{{/each}}
  };
{{/if}}
}

/** Schedules time events. The default uses setTimeout; tests can pass a fake one. */
export interface Clock {
  setTimeout(callback: () => void, ms: number): unknown;
  clearTimeout(handle: unknown): void;
}

export interface {{machine.name}}Options {
  clock?: Clock;
  /** The machine reached a final state in every top-level region. */
  onFinished?(): void;
  /** The machine left through one of its exit points. */
  onExitPoint?(point: {{machine.name}}ExitPoint): void;
}
