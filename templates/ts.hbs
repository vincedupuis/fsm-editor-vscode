// Generated by FSM Editor from {{machine.sourceFile}}.
// Do not edit: changes are lost when the code is regenerated.
import type {
  Clock,
  {{machine.name}}Actions,
  {{machine.name}}Activity,
  {{machine.name}}EntryPoint,
  {{machine.name}}Event,
  {{machine.name}}ExitPoint,
  {{machine.name}}Options,
  {{machine.name}}State,
} from './{{machine.name}}Actions';
{{#each submachines}}
import { {{name}} } from './{{name}}';
{{/each}}

export type {
  Clock,
  {{machine.name}}Actions,
  {{machine.name}}Activity,
  {{machine.name}}EntryPoint,
  {{machine.name}}Event,
  {{machine.name}}ExitPoint,
  {{machine.name}}Options,
  {{machine.name}}State,
};

const NONE = 0;
const DEFERRED = 1;
const FIRED = 2;
const COMPLETION = 0;
const EXIT_POINT = 1;

const STATE_NAMES: readonly {{machine.name}}State[] = [{{#each states}}{{#unless @first}}, {{/unless}}{{quote name}}{{/each}}];
/** Region containing each state. */
const REGION_OF: readonly number[] = [{{join states ", " "regionIndex"}}];
/** Regions of each state. */
const REGIONS_OF: readonly (readonly number[])[] = [{{#each states}}{{#unless @first}}, {{/unless}}[{{join regions ", " "index"}}]{{/each}}];
/** State owning each region (-1 for top-level regions). */
const OWNER_OF: readonly number[] = [{{join regions ", " "ownerIndex"}}];
const TOP_REGIONS: readonly number[] = [{{join topRegions ", " "index"}}];
const IS_FINAL: readonly boolean[] = [{{join states ", " "isFinal"}}];
/** When each state completes. */
const COMPLETES: readonly string[] = [{{#each states}}{{#unless @first}}, {{/unless}}{{quote completes}}{{/each}}];
{{#if features.activities}}
const STATE_ACTIVITIES: readonly (readonly string[])[] = [{{#each states}}{{#unless @first}}, {{/unless}}[{{#each activities}}{{#unless @first}}, {{/unless}}{{quote this}}{{/each}}]{{/each}}];
{{/if}}
{{#if features.deferral}}
/** Events deferred by each state. */
const DEFERS: readonly (readonly number[])[] = [{{#each states}}{{#unless @first}}, {{/unless}}[{{join deferred ", " "index"}}]{{/each}}];
{{/if}}
const EVENT_COUNT = {{events.length}};
const EVENT_SIGNAL: Readonly<Record<string, number>> = { {{#each events}}{{#unless @first}}, {{/unless}}{{quote name}}: {{signalIndex}}{{/each}} };
const SIGNAL_NAMES: readonly string[] = [{{#each signals}}{{#unless @first}}, {{/unless}}{{quote name}}{{/each}}];
/** Main source state of each transition. */
const SOURCE_OF: readonly number[] = [{{join transitions ", " "sourceIndex"}}];

/** A generated state machine used as a submachine. */
interface Submachine {
  start(): void;
  startAt(point: string): void;
  resume(): void;
  stop(): void;
  offer(event: string): number;
}

/**
 * {{machine.displayName}}{{#if machine.protocol}} (protocol state machine){{/if}}.
 *
 * Events are processed one at a time, each to completion. Call start() once,
 * then dispatch() events.
 */
export class {{machine.name}} {
  private readonly active: number[] = new Array({{regions.length}}).fill(-1);
  private readonly history: number[] = new Array({{regions.length}}).fill(-1);
  private readonly completed: boolean[] = new Array({{states.length}}).fill(false);
  private readonly queue: number[] = [];
  private readonly work: [number, number, string][] = [];
  private running = false;
  private finished = false;
  private terminated = false;
{{#if features.activities}}
  private readonly pending: number[] = new Array({{states.length}}).fill(0);
{{/if}}
{{#if features.deferral}}
  private deferred: number[] = [];
{{/if}}
{{#if features.preconditions}}
  private preconditionFailed = '';
{{/if}}
{{#if features.timers}}
  private readonly clock: Clock;
  private readonly timerHandles: unknown[] = new Array({{timers.length}}).fill(undefined);
{{/if}}
  private readonly submachines: Record<number, Submachine> = {};

  constructor(
    private readonly actions: {{machine.name}}Actions,
    private readonly options: {{machine.name}}Options = {},
  ) {
{{#if features.timers}}
    this.clock = options.clock ?? {
      setTimeout: (callback, ms) => setTimeout(callback, ms),
      clearTimeout: (handle) => clearTimeout(handle as ReturnType<typeof setTimeout>),
    };
{{/if}}
{{#each states}}
{{#if submachine}}
    this.submachines[{{index}}] = new {{submachine.machine}}(actions.submachines.{{name}}, {
      clock: options.clock,
      onFinished: () => this.post(COMPLETION, {{index}}, ''),
      onExitPoint: (point: string) => this.post(EXIT_POINT, {{index}}, point),
    });
{{/if}}
{{/each}}
  }

  /** Enters the machine through its initial pseudostates. */
  start(): void {
    this.reset();
    this.running = true;
    try {
      {{> steps steps=start}}
    } finally {
      this.running = false;
    }
    this.run();
  }

  /** Enters the machine through one of its entry points. */
  startAt(point: {{machine.name}}EntryPoint): void {
    this.reset();
    this.running = true;
    try {
      switch (point) {
{{#each entryPoints}}
        case {{quote name}}:
          {{> steps}}
          break;
{{/each}}
      }
    } finally {
      this.running = false;
    }
    this.run();
  }

  /** Re-enters the states that were active when the machine was last stopped. */
  resume(): void {
    this.reset();
    this.running = true;
    try {
      for (const region of TOP_REGIONS) if (!this.restore(region, true)) this.enterRegion(region);
    } finally {
      this.running = false;
    }
    this.run();
  }

  /** Leaves every active state, running their exit behaviors. */
  stop(): void {
    for (const region of TOP_REGIONS) this.exitRegion(region);
    this.queue.length = 0;
    this.work.length = 0;
  }

  /** Processes `event` after the events already queued. */
  dispatch(event: {{machine.name}}Event): void {
    if (this.terminated) return;
    this.queue.push(EVENT_SIGNAL[event]);
    this.run();
  }
{{#if features.activities}}

  /** A do activity ended by itself; its state completes once all its activities have ended. */
  activityDone(activity: {{machine.name}}Activity): void {
    STATE_ACTIVITIES.forEach((list, s) => {
      if (list.includes(activity) && this.isActive(s) && this.pending[s] > 0 && --this.pending[s] === 0) this.completion(s);
    });
    this.run();
  }
{{/if}}

  isIn(state: {{machine.name}}State): boolean {
    return this.isActive(STATE_NAMES.indexOf(state));
  }

  get activeStates(): {{machine.name}}State[] {
    return STATE_NAMES.filter((_, s) => this.isActive(s));
  }

  /** Every top-level region reached a final state. */
  get isFinished(): boolean {
    return this.finished;
  }

  /** A terminate pseudostate was reached. */
  get isTerminated(): boolean {
    return this.terminated;
  }

  /** @internal Offers an event to this machine running as a submachine; returns whether it was used. */
  offer(event: string): number {
    const signal = EVENT_SIGNAL[event];
    if (signal === undefined || this.terminated || this.running) return NONE;
    let result: number;
    this.running = true;
    try {
      result = this.process(signal);
    } finally {
      this.running = false;
    }
    this.run();
    return result === NONE ? NONE : FIRED;
  }

  // ---------------------------------------------------------------- run to completion

  private reset(): void {
    this.active.fill(-1);
    this.completed.fill(false);
    this.queue.length = 0;
    this.work.length = 0;
    this.finished = false;
    this.terminated = false;
{{#if features.deferral}}
    this.deferred = [];
{{/if}}
  }

  private run(): void {
    if (this.running) return;
    this.running = true;
    try {
      while (!this.terminated) {
        const item = this.work.shift();
        if (item) {
          const [kind, s, point] = item;
          if (this.isActive(s) && (kind === COMPLETION ? this.complete(s) : this.exitPoint(s, point))) {
            this.changed();
            this.checkInvariants();
          }
          continue;
        }
        const signal = this.queue.shift();
        if (signal === undefined) break;
        this.process(signal);
      }
    } finally {
      this.running = false;
    }
  }

  private post(kind: number, s: number, point: string): void {
    this.work.push([kind, s, point]);
    this.run();
  }

  /** One run-to-completion step: selects the enabled transitions, then fires them. */
  private process(signal: number): number {
{{#if features.preconditions}}
    this.preconditionFailed = '';
{{/if}}
    const chosen: number[] = [];
    let result = NONE;
    for (const region of TOP_REGIONS) result = Math.max(result, this.selectRegion(region, signal, chosen));
    for (const t of chosen) if (!this.terminated && this.isActive(SOURCE_OF[t])) this.fire(t);
    if (result === FIRED) this.changed();
{{#if features.deferral}}
    else if (result === DEFERRED) this.deferred.push(signal);
{{/if}}
{{#if features.preconditions}}
    else if (this.preconditionFailed) this.actions.onConstraintViolation('precondition', this.preconditionFailed);
{{/if}}
    this.checkInvariants();
    return result;
  }

  /** The configuration changed: deferred events get another chance. */
  private changed(): void {
{{#if features.deferral}}
    if (this.deferred.length) {
      this.queue.unshift(...this.deferred);
      this.deferred = [];
    }
{{/if}}
  }

  private selectRegion(region: number, signal: number, chosen: number[]): number {
    const s = this.active[region];
    return s < 0 ? NONE : this.selectState(s, signal, chosen);
  }

  /** Nested states first: a state's own transitions only apply when no substate used the event. */
  private selectState(s: number, signal: number, chosen: number[]): number {
    let result = NONE;
    for (const region of REGIONS_OF[s]) result = Math.max(result, this.selectRegion(region, signal, chosen));
    const sub = this.submachines[s];
    if (sub && signal < EVENT_COUNT) result = Math.max(result, sub.offer(SIGNAL_NAMES[signal]));
    if (result !== NONE) return result;
    if (this.select(s, signal, chosen)) return FIRED;
{{#if features.deferral}}
    if (DEFERS[s].includes(signal)) return DEFERRED;
{{/if}}
    return NONE;
  }

  /** The first enabled transition of `s` triggered by `signal`. */
  private select(s: number, signal: number, chosen: number[]): boolean {
    switch (s) {
{{#each states}}
{{#if handlers.length}}
      case {{index}}: // {{name}}
        switch (signal) {
{{#each handlers}}
          case {{signalIndex}}: // {{signal}}
{{#each candidates}}
            {{> choose}}
{{/each}}
{{#unless exhaustive}}
            break;
{{/unless}}
{{/each}}
        }
        break;
{{/if}}
{{/each}}
    }
    return false;
  }

  /** Completion event of `s`: its first enabled completion transition fires. */
  private complete(s: number): boolean {
    switch (s) {
{{#each states}}
{{#if completion.length}}
      case {{index}}: // {{name}}
{{#each completion}}
        {{> take}}
{{/each}}
        break;
{{/if}}
{{/each}}
    }
    return false;
  }

  /** The submachine of state `s` left through its exit point `point`. */
  private exitPoint(s: number, point: string): boolean {
    switch (s) {
{{#each states}}
{{#if exits.length}}
      case {{index}}: // {{name}}
        switch (point) {
{{#each exits}}
          case {{quote point}}:
{{#each candidates}}
            {{> take}}
{{/each}}
            break;
{{/each}}
        }
        break;
{{/if}}
{{/each}}
    }
    return false;
  }

  private fire(t: number): void {
    switch (t) {
{{#each transitions}}
      case {{index}}: { // {{label}}
        {{> steps}}
        break;
      }
{{/each}}
    }
  }

  // ---------------------------------------------------------------- entering and leaving states

  /** Enters `s` itself (not its regions) and runs its entry behavior. */
  private enter(s: number): void {
    this.active[REGION_OF[s]] = s;
    this.completed[s] = false;
{{#if features.activities}}
    if (COMPLETES[s] === 'activities') this.pending[s] = STATE_ACTIVITIES[s].length;
{{/if}}
    switch (s) {
{{#each states}}
{{#if entry.length}}
      case {{index}}: // {{name}}
        {{> steps steps=entry}}
        break;
{{/if}}
{{/each}}
    }
    if (IS_FINAL[s]) this.finalReached(REGION_OF[s]);
    else if (COMPLETES[s] === 'immediate') this.completion(s);
  }

  /** Leaves `s` and everything active inside it, innermost first. */
  private exit(s: number): void {
    const region = REGION_OF[s];
    if (this.active[region] !== s) return;
    for (const r of REGIONS_OF[s]) this.exitRegion(r);
    switch (s) {
{{#each states}}
{{#if exit.length}}
      case {{index}}: // {{name}}
        {{> steps steps=exit}}
        break;
{{/if}}
{{/each}}
    }
    this.active[region] = -1;
    this.history[region] = IS_FINAL[s] ? -1 : s;
    this.completed[s] = false;
  }

  private exitRegion(region: number): void {
    const s = this.active[region];
    if (s >= 0) this.exit(s);
  }

  /** Default entry of a region: the transition of its initial pseudostate. */
  private enterRegion(region: number): void {
    switch (region) {
{{#each regions}}
{{#if defaultSteps.length}}
      case {{index}}: // {{name}}
        {{> steps steps=defaultSteps}}
        break;
{{/if}}
{{/each}}
    }
  }

  /** Re-enters the state last active in `region`; false when there is none. */
  private restore(region: number, deep: boolean): boolean {
    const s = this.history[region];
    if (s < 0) return false;
    this.enter(s);
    for (const r of REGIONS_OF[s]) if (!deep || !this.restore(r, true)) this.enterRegion(r);
    const sub = this.submachines[s];
    if (sub) {
      if (deep) sub.resume();
      else sub.start();
    }
    return true;
  }

  private finalReached(region: number): void {
    const owner = OWNER_OF[region];
    const regions = owner < 0 ? TOP_REGIONS : REGIONS_OF[owner];
    if (!regions.every((r) => this.active[r] >= 0 && IS_FINAL[this.active[r]])) return;
    if (owner >= 0) this.completion(owner);
    else {
      this.finished = true;
      this.options.onFinished?.();
    }
  }

  private completion(s: number): void {
    this.completed[s] = true;
    this.work.push([COMPLETION, s, '']);
  }

  private allCompleted(states: number[]): boolean {
    return states.every((s) => this.isActive(s) && this.completed[s]);
  }

  private isActive(s: number): boolean {
    return s >= 0 && this.active[REGION_OF[s]] === s;
  }

  private exitMachine(point: {{machine.name}}ExitPoint): void {
    for (const region of TOP_REGIONS) this.exitRegion(region);
    this.options.onExitPoint?.(point);
  }
{{#if features.terminate}}

  private terminate(): void {
    this.terminated = true;
{{#if features.timers}}
    for (let t = 0; t < this.timerHandles.length; t++) this.cancelTimer(t);
{{/if}}
    this.queue.length = 0;
    this.work.length = 0;
    this.actions.onTerminate();
  }
{{/if}}
{{#if features.choices}}

  private noBranch(choice: string): never {
    throw new Error(`{{machine.name}}: no branch of the ${choice} can be taken.`);
  }
{{/if}}

  private checkInvariants(): void {
{{#each invariants}}
    if (this.isActive({{index}}) && !({{guard invariant}})) this.actions.onConstraintViolation('invariant', {{quote name}});
{{/each}}
  }
{{#if features.timers}}

  private startTimer(timer: number, ms: number): void {
    this.cancelTimer(timer);
    this.timerHandles[timer] = this.clock.setTimeout(() => {
      this.timerHandles[timer] = undefined;
      this.queue.push(EVENT_COUNT + timer);
      this.run();
    }, ms);
  }

  private cancelTimer(timer: number): void {
    const handle = this.timerHandles[timer];
    if (handle !== undefined) {
      this.clock.clearTimeout(handle);
      this.timerHandles[timer] = undefined;
    }
  }
{{/if}}
}
{{/file}}
