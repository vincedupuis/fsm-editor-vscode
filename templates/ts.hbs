---
# TypeScript: a class per state machine, without dependencies.
# For a machine named Order it writes:
#   OrderActions.ts      events, states and the OrderActions interface to implement
#   Order.ts             the Order class (run-to-completion state machine)
# Implement OrderActions in your own class, in a file of your own.
lang: ts
guard:
  prefix: "this.actions."
---
{{#*inline "steps"}}
{{#each steps}}
{{#if (eq kind "call")}}
this.actions.{{id action}}();
{{else if (eq kind "startActivity")}}
this.actions.start{{pascal activity}}();
{{else if (eq kind "stopActivity")}}
this.actions.stop{{pascal activity}}();
{{else if (eq kind "startTimer")}}
this.startTimer({{timerIndex}}, {{ms}}); // {{timer}}
{{else if (eq kind "cancelTimer")}}
this.cancelTimer({{timerIndex}}); // {{timer}}
{{else if (eq kind "exit")}}
this.exit({{stateIndex}}); // {{state}}
{{else if (eq kind "exitRegion")}}
this.exitRegion({{regionIndex}}); // {{region}}
{{else if (eq kind "enter")}}
this.enter({{stateIndex}}); // {{state}}
{{else if (eq kind "enterRegion")}}
this.enterRegion({{regionIndex}}); // {{region}}
{{else if (eq kind "restoreHistory")}}
if (!this.restore({{regionIndex}}, {{deep}})) { // {{#if deep}}deep {{/if}}history of {{region}}
  {{> steps steps=defaultSteps}}
}
{{else if (eq kind "choice")}}
{{> choice}}
{{else if (eq kind "startSubmachine")}}
{{#if point}}
this.submachines[{{stateIndex}}].startAt({{quote point}}); // {{state}}
{{else}}
this.submachines[{{stateIndex}}].start(); // {{state}}
{{/if}}
{{else if (eq kind "stopSubmachine")}}
this.submachines[{{stateIndex}}].stop(); // {{state}}
{{else if (eq kind "exitMachine")}}
this.exitMachine({{quote point}});
{{else if (eq kind "terminate")}}
this.terminate();
{{else if (eq kind "check")}}
if (!({{guard condition}})) this.actions.onConstraintViolation('{{constraint}}', {{quote element}});
{{/if}}
{{/each}}
{{/inline}}
{{#*inline "choice"}}
// {{label}}
{{#each branches}}
{{#if @first}}
if ({{guard guard}}) {
{{else if guard}}
} else if ({{guard guard}}) {
{{else}}
} else {
{{/if}}
  {{> steps}}
{{/each}}
{{#if hasElse}}
}
{{else}}
} else {
  this.noBranch({{quote label}});
}
{{/if}}
{{/inline}}
{{#*inline "take"}}
{{#if (or guard requires.length)}}
if ({{#if requires.length}}this.allCompleted([{{join requires ", " "index"}}]){{/if}}{{#if (and guard requires.length)}} && {{/if}}{{#if guard}}({{guard guard}}){{/if}}) {
  this.fire({{transitionIndex}}); // {{transition}}
  return true;
}
{{else}}
this.fire({{transitionIndex}}); // {{transition}}
return true;
{{/if}}
{{/inline}}
{{#*inline "choose"}}
{{#if precondition}}
if ({{guard guard}}) {
  if ({{guard precondition}}) {
    chosen.push({{transitionIndex}}); // {{transition}}
    return true;
  }
  if (!this.preconditionFailed) this.preconditionFailed = {{quote label}};
}
{{else if guard}}
if ({{guard guard}}) {
  chosen.push({{transitionIndex}}); // {{transition}}
  return true;
}
{{else}}
chosen.push({{transitionIndex}}); // {{transition}}
return true;
{{/if}}
{{/inline}}
