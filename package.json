{
  "name": "fsm-editor",
  "displayName": "FSM Editor — UML State Machines & Code Generation",
  "description": "Visual editor and code generator for UML 2.5.1 state machines: draw composite/orthogonal states, submachines with connection point references, all pseudostates and protocol state machines, then generate source code from Handlebars or Jinja templates (TypeScript and Boost.SML C++ bundled), in VS Code or with the standalone fsm command-line generator. Stored as standard XMI with UML DI layout, with validation and SVG and PNG export.",
  "version": "0.6.1",
  "publisher": "VinceGoSoftware",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#0a3d8f",
    "theme": "dark"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vincedupuis/fsm-editor-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/vincedupuis/fsm-editor-vscode/issues"
  },
  "homepage": "https://github.com/vincedupuis/fsm-editor-vscode#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "uml",
    "state machine",
    "fsm",
    "statechart",
    "diagram",
    "xmi",
    "umldi",
    "code generation",
    "code generator",
    "codegen",
    "handlebars",
    "jinja"
  ],
  "main": "./out/extension.js",
  "browser": "./out/web/extension.js",
  "bin": {
    "fsm": "./out/cli.js"
  },
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "fsmEditor.stateMachine",
        "displayName": "FSM Editor",
        "selector": [
          {
            "filenamePattern": "*.fsm"
          }
        ],
        "priority": "default"
      }
    ],
    "languages": [
      {
        "id": "xml",
        "extensions": [
          ".fsm"
        ]
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "fsmTracePlayer",
          "title": "Trace Player",
          "icon": "$(debug-alt)"
        }
      ]
    },
    "views": {
      "fsmTracePlayer": [
        {
          "type": "webview",
          "id": "fsmEditor.tracePlayer",
          "name": "Trace Player"
        }
      ]
    },
    "commands": [
      {
        "command": "fsmEditor.new",
        "title": "New State Machine",
        "category": "FSM"
      },
      {
        "command": "fsmEditor.newUntitled",
        "title": "New Untitled State Machine",
        "shortTitle": "State Machine",
        "category": "FSM"
      },
      {
        "command": "fsmEditor.exportSvg",
        "title": "Export as SVG",
        "category": "FSM"
      },
      {
        "command": "fsmEditor.exportPng",
        "title": "Export as PNG",
        "category": "FSM"
      },
      {
        "command": "fsmEditor.generateCode",
        "title": "Generate Code…",
        "category": "FSM"
      },
      {
        "command": "fsmEditor.openTrace",
        "title": "Open Trace…",
        "category": "FSM"
      },
      {
        "command": "fsmEditor.openAsText",
        "title": "Open as XMI Text",
        "category": "FSM",
        "icon": "$(json)"
      },
      {
        "command": "fsmEditor.openDiagram",
        "title": "Open in FSM Editor",
        "category": "FSM",
        "icon": "$(type-hierarchy)"
      }
    ],
    "menus": {
      "file/newFile": [
        {
          "command": "fsmEditor.newUntitled"
        }
      ],
      "editor/title": [
        {
          "command": "fsmEditor.openAsText",
          "when": "activeCustomEditorId == fsmEditor.stateMachine",
          "group": "navigation"
        },
        {
          "command": "fsmEditor.openDiagram",
          "when": "resourceExtname == .fsm && !activeCustomEditorId",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "fsmEditor.new",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "fsmEditor.generateCode",
          "when": "resourceExtname == .fsm",
          "group": "navigation@11"
        }
      ],
      "commandPalette": [
        {
          "command": "fsmEditor.generateCode",
          "when": "activeCustomEditorId == fsmEditor.stateMachine || resourceExtname == .fsm"
        },
        {
          "command": "fsmEditor.exportSvg",
          "when": "activeCustomEditorId == fsmEditor.stateMachine"
        },
        {
          "command": "fsmEditor.exportPng",
          "when": "activeCustomEditorId == fsmEditor.stateMachine"
        },
        {
          "command": "fsmEditor.openAsText",
          "when": "activeCustomEditorId == fsmEditor.stateMachine"
        },
        {
          "command": "fsmEditor.openDiagram",
          "when": "resourceExtname == .fsm"
        }
      ]
    },
    "configuration": {
      "title": "FSM Editor",
      "properties": {
        "fsmEditor.codegen.generatorPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path of `fsm-generator`, the code generator that runs Jinja templates (`.jinja`). Leave empty to use the one bundled with the extension, or else one found on the PATH. Not available in VS Code for the Web."
        },
        "fsmEditor.trace.formats": {
          "type": "array",
          "default": [],
          "scope": "resource",
          "markdownDescription": "Formats of the logs the Trace Player reads, besides its built-in format (`… fsm <machine> <kind> <id> <name>`, what an `onTrace` hook of the generated code can write). Each format has rules tried in order on each line: a regular expression whose named groups give the record (`time`, `machine`, `id`, `name`, and for transitions `source` and `target`) and its kind (`event`, `enter`, `exit` or `transition`, or a `kind` group). States and transitions are found by xmi:id, else by name; lines without a `machine` are about the format's `machine`, else a machine the Trace Player asks for.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "rules"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name shown in the Trace Player."
              },
              "rules": {
                "type": "array",
                "description": "Tried in order on each line; the first that matches makes the record.",
                "items": {
                  "type": "object",
                  "required": [
                    "match"
                  ],
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "event",
                        "enter",
                        "exit",
                        "transition"
                      ],
                      "description": "Kind of the records of this rule (else the `kind` group)."
                    },
                    "match": {
                      "type": "string",
                      "description": "Regular expression (JavaScript) with named groups: time, machine, id, name, source, target, kind."
                    }
                  }
                }
              },
              "time": {
                "type": "string",
                "description": "Optional regular expression whose `time` group gives the time of every line."
              },
              "machine": {
                "type": "string",
                "description": "Optional machine name for the lines without a `machine` group."
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check:webview": "node --check media/editor.js",
    "package": "npx @vscode/vsce package",
    "test:web": "tsc -p ./ && node esbuild.mjs --test && node test/web/run.mjs",
    "test:unit": "node test/unit/run.mjs",
    "build:bin": "node esbuild.mjs && node scripts/build-bin.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.2",
    "handlebars": "^4.7.9",
    "typescript": "^5.4.0"
  },
  "allowScripts": {
    "@playwright/browser-chromium@1.63.0": true,
    "esbuild@0.28.2": true
  }
}
